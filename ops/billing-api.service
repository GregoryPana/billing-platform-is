[Unit]
Description=Billing API
After=network.target

[Service]
Type=simple
User=billing
Group=billing
WorkingDirectory=/opt/billing/backend
EnvironmentFile=/opt/billing/backend/.env
ExecStart=/opt/billing/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/opt/billing

[Install]
WantedBy=multi-user.target
