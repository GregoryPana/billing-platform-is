VITE_API_URL=https://n8n-lan.cwsey.com/billing-api
VITE_APPROVAL_WEBHOOK_URL=https://n8n-lan.cwsey.com:8443/webhook/billing-approval-request
# Production must be VITE_AUTH_MODE=entra - Entra sign-in is mandatory and
# the local LoginPage is never rendered. See docs/entra-id-integration-plan.md.
VITE_AUTH_MODE=entra
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
VITE_ENTRA_API_SCOPE=api://<client-id>/access_as_user
VITE_ENTRA_REDIRECT_URI=https://n8n-lan.cwsey.com/billing/
VITE_ENTRA_POST_LOGOUT_REDIRECT_URI=https://n8n-lan.cwsey.com/billing/
